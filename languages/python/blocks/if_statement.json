{
  "concept_id": "if",
  "display_name": "If",
  "category": "Control",
  "is_container": true,
  "empty_body": "pass",
  "description": "Runs the blocks inside its body only when the condition is true.",
  "template": "if [[condition]]:\n[[body]]\n",
  "params": [
    {
      "name": "condition",
      "type": "boolean",
      "default": "True"
    }
  ],
  "match": {
    "node_kind": "if_statement",
    "slot_map": {
      "condition": "condition",
      "body": "consequence"
    }
  }
}
