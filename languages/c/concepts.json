{
  "print_output": {
    "concept_id": "output",
    "display_name": "Print Output",
    "category": "Basic",
    "description": "Prints an integer using printf. Assumes an int/%d value - use raw_code for other format specifiers (C has no generic print).",
    "template": "printf(\"%d\\n\", [[value]]);\n",
    "params": [
      {
        "name": "value",
        "type": "expression",
        "default": "0"
      }
    ]
  },
  "assign_variable": {
    "concept_id": "assign",
    "display_name": "Assign Variable",
    "category": "Basic",
    "description": "Declares an int variable and assigns it a value. Assumes int type - use raw_code for other types.",
    "template": "int [[variable]] = [[value]];\n",
    "params": [
      {
        "name": "variable",
        "type": "identifier",
        "default": "x"
      },
      {
        "name": "value",
        "type": "expression",
        "default": "0"
      }
    ]
  },
  "comment": {
    "concept_id": "comment",
    "display_name": "Comment",
    "category": "Basic",
    "description": "Adds a comment to the code.",
    "template": "// [[text]]\n",
    "params": [
      {
        "name": "text",
        "type": "string",
        "default": "This is a comment"
      }
    ]
  },
  "if_statement": {
    "concept_id": "if",
    "display_name": "If",
    "category": "Control",
    "is_container": true,
    "empty_body": "",
    "description": "Runs the body only when the condition is true.",
    "template": "if ([[condition]]) {\n[[body]]\n}\n",
    "params": [
      {
        "name": "condition",
        "type": "boolean",
        "default": "1"
      }
    ]
  },
  "loop_for": {
    "concept_id": "loop_for",
    "display_name": "For Loop",
    "category": "Control",
    "is_container": true,
    "empty_body": "",
    "description": "Classic indexed for loop. C has no built-in range-based/foreach iteration over plain arrays, so this uses start/end rather than the universal 'iterable' slot.",
    "template": "for (int [[variable]] = [[start]]; [[variable]] < [[end]]; [[variable]]++) {\n[[body]]\n}\n",
    "params": [
      {
        "name": "variable",
        "type": "identifier",
        "default": "i"
      },
      {
        "name": "start",
        "type": "expression",
        "default": "0"
      },
      {
        "name": "end",
        "type": "expression",
        "default": "10"
      }
    ]
  },
  "loop_while": {
    "concept_id": "loop_while",
    "display_name": "While Loop",
    "category": "Control",
    "is_container": true,
    "empty_body": "",
    "description": "Repeats the body while the condition is true.",
    "template": "while ([[condition]]) {\n[[body]]\n}\n",
    "params": [
      {
        "name": "condition",
        "type": "boolean",
        "default": "1"
      }
    ]
  },
  "func_def": {
    "concept_id": "func_def",
    "display_name": "Define Function",
    "category": "Functions",
    "is_container": true,
    "empty_body": "",
    "description": "Defines a function. Return type defaults to void - use raw_code for other return types.",
    "template": "void [[name]]([[params]]) {\n[[body]]\n}\n",
    "params": [
      {
        "name": "name",
        "type": "identifier",
        "default": "my_function"
      },
      {
        "name": "params",
        "type": "expression",
        "default": "void"
      }
    ]
  },
  "func_call": {
    "concept_id": "func_call",
    "display_name": "Call Function",
    "category": "Functions",
    "description": "Calls a function.",
    "template": "[[name]]([[args]]);\n",
    "params": [
      {
        "name": "name",
        "type": "identifier",
        "default": "my_function"
      },
      {
        "name": "args",
        "type": "expression",
        "default": ""
      }
    ]
  },
  "return_statement": {
    "concept_id": "return",
    "display_name": "Return",
    "category": "Functions",
    "description": "Returns a value from a function.",
    "template": "return [[value]];\n",
    "params": [
      {
        "name": "value",
        "type": "expression",
        "default": "0"
      }
    ]
  },
  "list_create": {
    "concept_id": "list_create",
    "display_name": "Create Array",
    "category": "Data Structures",
    "description": "Creates a fixed-size int array with initial items. C arrays cannot grow at runtime - see list_append.",
    "template": "int [[variable]][] = {[[items]]};\n",
    "params": [
      {
        "name": "variable",
        "type": "identifier",
        "default": "my_array"
      },
      {
        "name": "items",
        "type": "expression",
        "default": "1, 2, 3"
      }
    ]
  },
  "list_append": {
    "display_name": "Append to Array (not supported)",
    "category": "Data Structures",
    "description": "Plain C arrays are fixed-size and cannot grow at runtime. No concept_id: this generates a comment, not code, so it never silently produces something that looks like it works but doesn't. Use malloc/realloc manually (see raw_code) for a real growable array.",
    "template": "// TODO: C arrays are fixed-size - to append [[item]] to [[list]], declare it with malloc/realloc instead of a fixed array literal\n",
    "params": [
      {
        "name": "list",
        "type": "identifier",
        "default": "my_array"
      },
      {
        "name": "item",
        "type": "expression",
        "default": "0"
      }
    ]
  },
  "raw_code": {
    "display_name": "Raw Code",
    "category": "Advanced",
    "description": "Write raw C code directly.",
    "template": "[[code]]\n",
    "params": [
      {
        "name": "code",
        "type": "expression",
        "default": ""
      }
    ]
  },
  "import_module": {
    "display_name": "Include Header",
    "category": "Advanced",
    "description": "Includes a header file. C standard headers keep the .h extension (unlike modern C++).",
    "template": "#include <[[module]]>\n",
    "params": [
      {
        "name": "module",
        "type": "identifier",
        "default": "stdio.h"
      }
    ]
  }
}