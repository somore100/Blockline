{
  "concept_id": "loop_for",
  "display_name": "For Loop",
  "category": "Control",
  "is_container": true,
  "empty_body": "",
  "description": "Iterates over a slice/map using for-range, discarding the index/key with '_'.",
  "template": "for _, [[variable]] := range [[iterable]] {\n[[body]]\n}\n",
  "params": [
    {
      "name": "variable",
      "type": "identifier",
      "default": "item"
    },
    {
      "name": "iterable",
      "type": "expression",
      "default": "myList"
    }
  ]
}
