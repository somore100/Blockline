{
  "print_output": {
    "concept_id": "output",
    "display_name": "Print Output",
    "category": "Basic",
    "description": "Prints a value using the println! macro.",
    "template": "println!(\"{}\", [[value]]);\n",
    "params": [
      {
        "name": "value",
        "type": "expression",
        "default": "\"Hello, World!\""
      }
    ]
  },
  "assign_variable": {
    "concept_id": "assign",
    "display_name": "Assign Variable",
    "category": "Basic",
    "description": "Binds a value to a new immutable variable via 'let'. IMPORTANT: this always creates a NEW binding (Rust shadowing) - it does not mutate an existing variable of the same name. For true reassignment, the variable needs 'let mut' once, then bare '[[variable]] = [[value]];' afterwards (use raw_code for that second form).",
    "template": "let [[variable]] = [[value]];\n",
    "params": [
      {
        "name": "variable",
        "type": "identifier",
        "default": "x"
      },
      {
        "name": "value",
        "type": "expression",
        "default": "0"
      }
    ]
  },
  "comment": {
    "concept_id": "comment",
    "display_name": "Comment",
    "category": "Basic",
    "description": "Adds a comment to the code.",
    "template": "// [[text]]\n",
    "params": [
      {
        "name": "text",
        "type": "string",
        "default": "This is a comment"
      }
    ]
  },
  "if_statement": {
    "concept_id": "if",
    "display_name": "If",
    "category": "Control",
    "is_container": true,
    "empty_body": "",
    "description": "Runs the body only when the condition is true. Rust's if has no parentheses around the condition.",
    "template": "if [[condition]] {\n[[body]]\n}\n",
    "params": [
      {
        "name": "condition",
        "type": "boolean",
        "default": "true"
      }
    ]
  },
  "loop_for": {
    "concept_id": "loop_for",
    "display_name": "For Loop",
    "category": "Control",
    "is_container": true,
    "empty_body": "",
    "description": "Iterates over an iterable/range - idiomatic Rust, matches the universal 'iterable' slot directly (e.g. try '0..10' as the iterable for a numeric range).",
    "template": "for [[variable]] in [[iterable]] {\n[[body]]\n}\n",
    "params": [
      {
        "name": "variable",
        "type": "identifier",
        "default": "item"
      },
      {
        "name": "iterable",
        "type": "expression",
        "default": "0..10"
      }
    ]
  },
  "loop_while": {
    "concept_id": "loop_while",
    "display_name": "While Loop",
    "category": "Control",
    "is_container": true,
    "empty_body": "",
    "description": "Repeats the body while the condition is true. No parentheses around the condition.",
    "template": "while [[condition]] {\n[[body]]\n}\n",
    "params": [
      {
        "name": "condition",
        "type": "boolean",
        "default": "true"
      }
    ]
  },
  "func_def": {
    "concept_id": "func_def",
    "display_name": "Define Function",
    "category": "Functions",
    "is_container": true,
    "empty_body": "",
    "description": "Defines a function with no return type (unit '()' return, implicit).",
    "template": "fn [[name]]([[params]]) {\n[[body]]\n}\n",
    "params": [
      {
        "name": "name",
        "type": "identifier",
        "default": "my_function"
      },
      {
        "name": "params",
        "type": "expression",
        "default": ""
      }
    ]
  },
  "func_call": {
    "concept_id": "func_call",
    "display_name": "Call Function",
    "category": "Functions",
    "description": "Calls a function.",
    "template": "[[name]]([[args]]);\n",
    "params": [
      {
        "name": "name",
        "type": "identifier",
        "default": "my_function"
      },
      {
        "name": "args",
        "type": "expression",
        "default": ""
      }
    ]
  },
  "return_statement": {
    "concept_id": "return",
    "display_name": "Return",
    "category": "Functions",
    "description": "Explicit early return of a value from a function (Rust functions can also return via a final expression with no semicolon, which this block does not cover).",
    "template": "return [[value]];\n",
    "params": [
      {
        "name": "value",
        "type": "expression",
        "default": ""
      }
    ]
  },
  "list_create": {
    "concept_id": "list_create",
    "display_name": "Create Vector",
    "category": "Data Structures",
    "description": "Creates a growable Vec using the vec! macro. Declared 'mut' so list_append works on it immediately.",
    "template": "let mut [[variable]] = vec![[[items]]];\n",
    "params": [
      {
        "name": "variable",
        "type": "identifier",
        "default": "my_vec"
      },
      {
        "name": "items",
        "type": "expression",
        "default": "1, 2, 3"
      }
    ]
  },
  "list_append": {
    "concept_id": "list_append",
    "display_name": "Push to Vector",
    "category": "Data Structures",
    "description": "Adds an item to the end of a Vec. Requires the vec was declared with 'mut' (see list_create).",
    "template": "[[list]].push([[item]]);\n",
    "params": [
      {
        "name": "list",
        "type": "identifier",
        "default": "my_vec"
      },
      {
        "name": "item",
        "type": "expression",
        "default": "0"
      }
    ]
  },
  "raw_code": {
    "display_name": "Raw Code",
    "category": "Advanced",
    "description": "Write raw Rust code directly.",
    "template": "[[code]]\n",
    "params": [
      {
        "name": "code",
        "type": "expression",
        "default": ""
      }
    ]
  },
  "import_module": {
    "display_name": "Use Declaration",
    "category": "Advanced",
    "description": "Brings a path into scope.",
    "template": "use [[module]];\n",
    "params": [
      {
        "name": "module",
        "type": "identifier",
        "default": "std::collections::HashMap"
      }
    ]
  }
}