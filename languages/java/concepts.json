{
  "print_output": {
    "concept_id": "output",
    "display_name": "Print Output",
    "category": "Basic",
    "description": "Prints a value to standard output.",
    "template": "System.out.println([[value]]);\n",
    "params": [
      {
        "name": "value",
        "type": "expression",
        "default": "\"Hello, World!\""
      }
    ]
  },
  "assign_variable": {
    "concept_id": "assign",
    "display_name": "Assign Variable",
    "category": "Basic",
    "description": "Declares a local variable with type inference (Java 10+ 'var') and assigns a value.",
    "template": "var [[variable]] = [[value]];\n",
    "params": [
      {
        "name": "variable",
        "type": "identifier",
        "default": "x"
      },
      {
        "name": "value",
        "type": "expression",
        "default": "0"
      }
    ]
  },
  "comment": {
    "concept_id": "comment",
    "display_name": "Comment",
    "category": "Basic",
    "description": "Adds a comment to the code.",
    "template": "// [[text]]\n",
    "params": [
      {
        "name": "text",
        "type": "string",
        "default": "This is a comment"
      }
    ]
  },
  "if_statement": {
    "concept_id": "if",
    "display_name": "If",
    "category": "Control",
    "is_container": true,
    "empty_body": "",
    "description": "Runs the body only when the condition is true.",
    "template": "if ([[condition]]) {\n[[body]]\n}\n",
    "params": [
      {
        "name": "condition",
        "type": "boolean",
        "default": "true"
      }
    ]
  },
  "loop_for": {
    "concept_id": "loop_for",
    "display_name": "For Loop",
    "category": "Control",
    "is_container": true,
    "empty_body": "",
    "description": "Enhanced for-loop (foreach) over an iterable, using var for the element type (Java 10+).",
    "template": "for (var [[variable]] : [[iterable]]) {\n[[body]]\n}\n",
    "params": [
      {
        "name": "variable",
        "type": "identifier",
        "default": "item"
      },
      {
        "name": "iterable",
        "type": "expression",
        "default": "myList"
      }
    ]
  },
  "loop_while": {
    "concept_id": "loop_while",
    "display_name": "While Loop",
    "category": "Control",
    "is_container": true,
    "empty_body": "",
    "description": "Repeats the body while the condition is true.",
    "template": "while ([[condition]]) {\n[[body]]\n}\n",
    "params": [
      {
        "name": "condition",
        "type": "boolean",
        "default": "true"
      }
    ]
  },
  "func_def": {
    "concept_id": "func_def",
    "display_name": "Define Method",
    "category": "Functions",
    "is_container": true,
    "empty_body": "",
    "description": "Defines a public static void method. Assumes it will be placed inside a class - Java has no free-standing top-level methods.",
    "template": "public static void [[name]]([[params]]) {\n[[body]]\n}\n",
    "params": [
      {
        "name": "name",
        "type": "identifier",
        "default": "myMethod"
      },
      {
        "name": "params",
        "type": "expression",
        "default": ""
      }
    ]
  },
  "func_call": {
    "concept_id": "func_call",
    "display_name": "Call Method",
    "category": "Functions",
    "description": "Calls a method.",
    "template": "[[name]]([[args]]);\n",
    "params": [
      {
        "name": "name",
        "type": "identifier",
        "default": "myMethod"
      },
      {
        "name": "args",
        "type": "expression",
        "default": ""
      }
    ]
  },
  "return_statement": {
    "concept_id": "return",
    "display_name": "Return",
    "category": "Functions",
    "description": "Returns a value from a method.",
    "template": "return [[value]];\n",
    "params": [
      {
        "name": "value",
        "type": "expression",
        "default": ""
      }
    ]
  },
  "list_create": {
    "concept_id": "list_create",
    "display_name": "Create List",
    "category": "Data Structures",
    "description": "Creates a mutable ArrayList with initial items, using fully-qualified names so it works without extra import blocks.",
    "template": "var [[variable]] = new java.util.ArrayList<[[type]]>(java.util.List.of([[items]]));\n",
    "params": [
      {
        "name": "type",
        "type": "string",
        "default": "Integer"
      },
      {
        "name": "variable",
        "type": "identifier",
        "default": "myList"
      },
      {
        "name": "items",
        "type": "expression",
        "default": "1, 2, 3"
      }
    ]
  },
  "list_append": {
    "concept_id": "list_append",
    "display_name": "Append to List",
    "category": "Data Structures",
    "description": "Adds an item to the end of a List.",
    "template": "[[list]].add([[item]]);\n",
    "params": [
      {
        "name": "list",
        "type": "identifier",
        "default": "myList"
      },
      {
        "name": "item",
        "type": "expression",
        "default": "0"
      }
    ]
  },
  "raw_code": {
    "display_name": "Raw Code",
    "category": "Advanced",
    "description": "Write raw Java code directly.",
    "template": "[[code]]\n",
    "params": [
      {
        "name": "code",
        "type": "expression",
        "default": ""
      }
    ]
  },
  "import_module": {
    "display_name": "Import",
    "category": "Advanced",
    "description": "Imports a class or package.",
    "template": "import [[module]];\n",
    "params": [
      {
        "name": "module",
        "type": "identifier",
        "default": "java.util.List"
      }
    ]
  }
}